# Copia este fichero a .env y ajusta los valores.
# .env NUNCA se sube al repositorio (ver .gitignore).

# --- PostgreSQL (credenciales del superusuario) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Base de datos del User Service ---
USER_DB=user_db
USER_DB_USER=usersvc
USER_DB_PASSWORD=usersvc

# --- Base de datos del Product Service ---
PRODUCT_DB=product_db
PRODUCT_DB_USER=prodsvc
PRODUCT_DB_PASSWORD=prodsvc

# --- Seguridad / JWT ---
JWT_SECRET=dev-secret-change-me-in-production-0123456789abcdef
JWT_EXPIRATION_MS=3600000

# --- Usuario admin creado al arrancar el User Service ---
ADMIN_PASSWORD=admin123

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Rate limiting del API Gateway ---
RATE_LIMIT_REPLENISH=20
RATE_LIMIT_BURST=40

# --- Rate limiting del registro de usuarios ---
REGISTER_RATE_LIMIT_REPLENISH=5
REGISTER_RATE_LIMIT_BURST=10

# --- Rate limiting del reenvío de verificación ---
RESEND_RATE_LIMIT_REPLENISH=3
RESEND_RATE_LIMIT_BURST=6

# --- Correo electrónico de verificación ---
# MailHog (dev): no necesita credenciales (auth false).
# Para SMTP real, pon los valores de tu proveedor y MAIL_SMTP_AUTH=true.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ecommerce.local
MAIL_FROM_NAME=E-Commerce
# URL pública del frontend con la que se construye el enlace de verificación
APP_PUBLIC_URL=https://localhost
# Validez del enlace de verificación en horas
VERIFY_TOKEN_TTL_HOURS=24

# --- Marca (frontend) ---
# Puedes editarla con el configurador web: `make env-config`
VITE_APP_NAME=E-Commerce

# Colores de acento (modo claro)
VITE_PRIMARY_COLOR="#6366f1"
VITE_SECONDARY_COLOR="#a855f7"
VITE_ACCENT_COLOR="#ec4899"

# Colores de acento (modo oscuro)
VITE_PRIMARY_COLOR_DARK="#818cf8"
VITE_SECONDARY_COLOR_DARK="#c084fc"
VITE_ACCENT_COLOR_DARK="#f472b6"

# Favicon y logo: ruta relativa a este .env (raiz del proyecto).
# Vacios = el frontend genera el favicon con la inicial del nombre.
VITE_FAVICON_PATH=
VITE_LOGO_PATH=
